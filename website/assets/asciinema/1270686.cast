[0.569, "o", "\u001b[31m⌁\u001b[m\u000f\u001b[1m\u001b[32m66%\u001b[m\u000f \u001b[1m\u001b[34m[\u001b[m\u000fkush\u001b[m\u000f\u001b[32m:\u001b[m\u000f\u001b[m\u000f\u001b[1m~\u001b[m\u000f\u001b[1m\u001b[34m]\u001b[m\u000f\u001b[1m\u001b[32m└3\u001b[m\u000f \u001b[1m$\u001b[m\u000f "]
[2.000, "o", "perch setup \\\r\n>   --config ~/.local/config/perch/config.yaml \\\r\n> "]
